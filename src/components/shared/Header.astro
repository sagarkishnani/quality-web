---
import HeaderReact from "./HeaderReact";
import client from "../../../tina/__generated__/client";
import { loadServices } from "../../lib/content/services";
import { loadCatalogNav } from "../../lib/content/catalogNav";
import type { Locale } from "../../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const [result, services, catalog] = await Promise.all([
  client.queries.global({ relativePath: "index.json" }),
  loadServices(),
  loadCatalogNav(),
]);
---

<HeaderReact
  query={result.query}
  variables={result.variables}
  data={result.data}
  locale={locale}
  currentPath={Astro.url.pathname}
  services={services.map((s) => ({ label: s.name, href: s.href }))}
  catalog={catalog}
  client:load
/>
