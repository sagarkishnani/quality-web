---
import client from "../../../tina/__generated__/client";

const result = await client.queries.global({ relativePath: "index.json" });
const contact = result.data?.global?.contact;
const number = (contact?.whatsappNumber || "").replace(/\D/g, "");
const href = number
  ? `https://wa.me/${number}${contact?.whatsappMessage ? `?text=${encodeURIComponent(contact.whatsappMessage)}` : ""}`
  : "";
const label = contact?.whatsappLabel || "Escríbenos por WhatsApp";
---

{href && (
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={label}
    class="whatsapp-button group fixed bottom-6 right-6 z-40 flex items-center gap-3 md:bottom-8 md:right-8"
  >
    <span class="hidden items-center gap-2 rounded-full bg-surface-raised py-2.5 pl-3.5 pr-4 text-body-sm font-medium text-content shadow-lg transition-transform duration-300 group-hover:-translate-x-1 md:inline-flex">
      <span class="h-2 w-2 rounded-full bg-brand-secondary" aria-hidden="true"></span>
      {label}
    </span>
    <span class="relative block h-14 w-14 shrink-0">
      <span class="absolute inset-0 animate-wave rounded-full bg-brand-secondary" aria-hidden="true"></span>
      <span class="absolute inset-0 animate-wave rounded-full bg-brand-secondary [animation-delay:1.3s]" aria-hidden="true"></span>
      <span class="relative flex h-14 w-14 items-center justify-center rounded-full bg-brand-secondary text-white shadow-lg">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
          <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 0 1-4.8-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.19 4.23-9.41 9.43-9.41a9.36 9.36 0 0 1 9.41 9.42c0 5.19-4.23 9.41-9.42 9.41zm8.02-17.43A11.27 11.27 0 0 0 12.04.75C5.79.75.7 5.83.7 12.08c0 2 .52 3.95 1.52 5.66L.6 23.6l6-1.57a11.3 11.3 0 0 0 5.43 1.38h.01c6.25 0 11.34-5.08 11.34-11.33 0-3.03-1.18-5.87-3.32-8.01z"/>
        </svg>
      </span>
    </span>
  </a>
)}
