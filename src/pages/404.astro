---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL || "/";
---

<BaseLayout title="Página no encontrada — Quality Sumprint">
  <section class="flex min-h-[70vh] items-center">
    <div class="container-xl text-center">
      <p class="eyebrow-caps text-brand-secondary-dark">404</p>
      <h1 class="mt-4 text-heading-lg">Esta página no existe</h1>
      <p class="mx-auto mt-4 max-w-md text-body-lg text-content-muted">
        Puede que el enlace esté roto o que la página se haya movido.
      </p>
      <a class="btn-primary mt-8" href={base}>Volver al inicio</a>
    </div>
  </section>
</BaseLayout>
